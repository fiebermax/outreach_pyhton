# Kopieren nach .env und Werte eintragen. .env wird nie committet.

# --- Datenquellen / KI ---
GOOGLE_PLACES_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Kostenbremse Google Places ---
PLACES_MAX_REQUESTS_PER_RUN=30
PLACES_MONTHLY_LIMIT=800
PLACES_CACHE_DAYS=30

# --- E-Mail (Versand ist standardmäßig aus) ---
MAIL_MODE=draft            # draft | smtp
SEND_ENABLED=false         # zweiter Schalter: erst true UND smtp versendet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_ADDRESS=

# --- Speicher ---
DATABASE_PATH=data/outreach.db

# --- Crawler ---
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=5000000
CRAWL_MAX_PAGES=8
CRAWL_MAX_DEPTH=2
CRAWL_MAX_SECONDS_PER_SITE=90
CRAWL_CONCURRENCY=4
CRAWL_RETRIES=2
MIN_EXTRACTION_QUALITY=0.5
CONSENT_POLICY=reject      # none | reject | reject_then_accept (Zustimmen nur bewusst aktivieren)

# --- Betrieb ---
CONTACT_COOLDOWN_DAYS=365     # nach jedem Kontakt so lange keine neue Ansprache
LOG_LEVEL=INFO
AI_MAX_COST_EUR=2.00
